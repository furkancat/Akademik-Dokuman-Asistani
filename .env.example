# ==========================================
# Yerel Akademik Doküman Asistanı - Çevre Değişkenleri
# .env dosyasını kopyalayıp kendi ayarlarınızı yapın:
# cp .env.example .env
# ==========================================

# --- OLLAMA YAPILANDIRMASI ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:latest
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048

# --- EMBEDDING YAPILANDIRMASI ---
# "sentence-transformers/all-MiniLM-L6-v2"     # 80MB  - Hızlı, hafif (ÖNERİLEN)
# "sentence-transformers/all-mpnet-base-v2"    # 420MB - Daha iyi kalite
# "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"  # 420MB - Çok dilli
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- FAISS YAPILANDIRMASI ---
FAISS_INDEX_TYPE=Flat
FAISS_NLIST=100

# --- DOKÜMAN BÖLÜMLEME ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- ARXIV API ---
ARXIV_MAX_RESULTS=100
ARXIV_DELAY_SECONDS=3

# --- RAG PARAMETRELERİ ---
RETRIEVER_K=5
RETRIEVER_SCORE_THRESHOLD=0.0

# --- LOGGING ---
LOG_LEVEL=INFO
